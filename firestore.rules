rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeGamePath() {
      return /databases/$(database)/documents/active-game/current;
    }

    match /active-game/current {
      function staleGame() {
        let game = get(/databases/$(database)/documents/games/$(resource.data.gameId)).data;
        let lastActivity = ('lastActivityAt' in game.keys()) ? game.lastActivityAt : game.createdAt;
        return game.status != 'playing'
          || lastActivity <= request.time.toMillis() - 7200000;
      }
      function validNewActiveGame() {
        return request.resource.data.keys().hasAll(['gameId', 'directorUid'])
          && request.resource.data.keys().hasOnly(['gameId', 'directorUid'])
          && request.resource.data.gameId is string
          && request.resource.data.directorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.directorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.status == 'playing';
      }
      // Clients need this small lock record to replace an expired game transactionally.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validNewActiveGame();
      allow update: if signedIn() && staleGame() && validNewActiveGame();
      allow delete: if signedIn()
        && resource.data.directorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/games/$(resource.data.gameId)).data.status in ['finished', 'cancelled'];
    }

    // Friendly aliases -> unguessable game IDs. Lookup by exact code only.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['gameId'])
        && request.resource.data.gameId is string
        && getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.directorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /games/{gameId} {
      function gameData() {
        return resource.data;
      }
      function currentTimestamp(value) {
        return value is int
          && value >= request.time.toMillis() - 300000
          && value <= request.time.toMillis() + 300000;
      }
      function staleGameData() {
        let lastActivity = ('lastActivityAt' in gameData().keys()) ? gameData().lastActivityAt : gameData().createdAt;
        return gameData().status == 'playing' && lastActivity <= request.time.toMillis() - 7200000;
      }
      function isDirector() {
        return signedIn() && request.auth.uid == gameData().directorUid;
      }
      function ownsTable() {
        return signedIn() && ((('1' in gameData().tables.keys()) && gameData().tables['1'] == request.auth.uid)
          || (('2' in gameData().tables.keys()) && gameData().tables['2'] == request.auth.uid)
          || (('3' in gameData().tables.keys()) && gameData().tables['3'] == request.auth.uid));
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['status', 'movement', 'tableCount', 'pairs', 'directorUid', 'tables', 'resultCount', 'createdAt', 'lastActivityAt'])
        && request.resource.data.status == 'playing'
        && request.resource.data.directorUid == request.auth.uid
        && request.resource.data.directorUid is string && request.resource.data.directorUid.size() <= 64
        && ((request.resource.data.movement == 'howell'
          && request.resource.data.tableCount in [2, 3]
          && request.resource.data.pairs is list
          && request.resource.data.pairs.size() == request.resource.data.tableCount * 2
          && request.resource.data.pairs[0] is string && request.resource.data.pairs[0].size() <= 60
          && request.resource.data.pairs[1] is string && request.resource.data.pairs[1].size() <= 60
          && request.resource.data.pairs[2] is string && request.resource.data.pairs[2].size() <= 60
          && request.resource.data.pairs[3] is string && request.resource.data.pairs[3].size() <= 60
          && (request.resource.data.tableCount == 2 || (request.resource.data.pairs[4] is string && request.resource.data.pairs[4].size() <= 60 && request.resource.data.pairs[5] is string && request.resource.data.pairs[5].size() <= 60)))
          || ((!('movement' in request.resource.data.keys()) || request.resource.data.movement == 'mitchell')
            && !('tableCount' in request.resource.data.keys())
            && request.resource.data.pairs is map
            && request.resource.data.pairs.keys().hasOnly(['ns', 'ew'])
            && request.resource.data.pairs.ns is list
            && request.resource.data.pairs.ew is list
            && request.resource.data.pairs.ns.size() == 3
            && request.resource.data.pairs.ew.size() == 3
            && request.resource.data.pairs.ns[0] is string && request.resource.data.pairs.ns[0].size() <= 60
            && request.resource.data.pairs.ns[1] is string && request.resource.data.pairs.ns[1].size() <= 60
            && request.resource.data.pairs.ns[2] is string && request.resource.data.pairs.ns[2].size() <= 60
            && request.resource.data.pairs.ew[0] is string && request.resource.data.pairs.ew[0].size() <= 60
            && request.resource.data.pairs.ew[1] is string && request.resource.data.pairs.ew[1].size() <= 60
            && request.resource.data.pairs.ew[2] is string && request.resource.data.pairs.ew[2].size() <= 60))
        && request.resource.data.tables is map
        && request.resource.data.tables.keys().size() == 0
        && request.resource.data.resultCount == 0
        && request.resource.data.createdAt is int
        && currentTimestamp(request.resource.data.lastActivityAt)
        && request.resource.data.lastActivityAt == request.resource.data.createdAt
        && getAfter(activeGamePath()).data.gameId == gameId
        && getAfter(activeGamePath()).data.directorUid == request.auth.uid;
      function validTableClaim() {
        return gameData().status == 'playing'
          && validActivityUpdate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tables', 'lastActivityAt'])
          && ((!('movement' in gameData().keys()) || gameData().movement != 'howell') && request.resource.data.tables.keys().hasOnly(['1', '2', '3'])
            || (gameData().movement == 'howell' && gameData().tableCount == 2 && request.resource.data.tables.keys().hasOnly(['1', '2']))
            || (gameData().movement == 'howell' && gameData().tableCount == 3 && request.resource.data.tables.keys().hasOnly(['1', '2', '3'])))
          && !((('1' in gameData().tables.keys()) && gameData().tables['1'] == request.auth.uid)
            || (('2' in gameData().tables.keys()) && gameData().tables['2'] == request.auth.uid)
            || (('3' in gameData().tables.keys()) && gameData().tables['3'] == request.auth.uid))
          && ((request.resource.data.tables.diff(gameData().tables).affectedKeys().hasOnly(['1'])
                && !('1' in gameData().tables.keys())
                && request.resource.data.tables['1'] == request.auth.uid)
            || (request.resource.data.tables.diff(gameData().tables).affectedKeys().hasOnly(['2'])
                && !('2' in gameData().tables.keys())
                && request.resource.data.tables['2'] == request.auth.uid)
            || (((!('movement' in gameData().keys()) || gameData().movement != 'howell') || gameData().tableCount == 3)
                && request.resource.data.tables.diff(gameData().tables).affectedKeys().hasOnly(['3'])
                && !('3' in gameData().tables.keys())
                && request.resource.data.tables['3'] == request.auth.uid));
      }
      function validDirectorTableRelease() {
        return isDirector()
          && gameData().status == 'playing'
          && validActivityUpdate()
          && request.resource.data.diff(gameData()).affectedKeys().hasOnly(['tables', 'lastActivityAt'])
          && request.resource.data.tables.diff(gameData().tables).addedKeys().size() == 0
          && request.resource.data.tables.diff(gameData().tables).changedKeys().size() == 0
          && request.resource.data.tables.diff(gameData().tables).removedKeys().hasOnly(['1', '2', '3']);
      }
      function validResultCountUpdate() {
        return (isDirector() || ownsTable())
          && gameData().status == 'playing'
          && validActivityUpdate()
          && request.resource.data.diff(gameData()).affectedKeys().hasOnly(['resultCount', 'lastActivityAt'])
          && request.resource.data.resultCount is int
          && request.resource.data.resultCount >= 1 && request.resource.data.resultCount <= ((!('movement' in gameData().keys()) || gameData().movement != 'howell') ? 36 : gameData().tableCount == 2 ? 12 : 30)
          && request.resource.data.resultCount == gameData().resultCount + 1;
      }
      function validActivityUpdate() {
        return currentTimestamp(request.resource.data.lastActivityAt)
          && (!('lastActivityAt' in gameData().keys()) || request.resource.data.lastActivityAt >= gameData().lastActivityAt);
      }
      function validDirectorActivityUpdate() {
        return isDirector()
          && gameData().status == 'playing'
          && validActivityUpdate()
          && request.resource.data.diff(gameData()).affectedKeys().hasOnly(['lastActivityAt']);
      }
      function validGameClosure() {
        return isDirector()
          && gameData().status == 'playing'
          && request.resource.data.diff(gameData()).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['finished', 'cancelled']
          && (request.resource.data.status == 'cancelled' || gameData().resultCount == ((!('movement' in gameData().keys()) || gameData().movement != 'howell') ? 36 : gameData().tableCount == 2 ? 12 : 30))
          && !existsAfter(activeGamePath());
      }
      function validStaleGameCancellation() {
        return staleGameData()
          && request.resource.data.diff(gameData()).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled';
      }
      // Table claims are immutable per device. Finishing or cancelling clears the active-game lock.
      allow update: if signedIn() && (
        validDirectorTableRelease()
        || validGameClosure()
        || validStaleGameCancellation()
        || validResultCountUpdate()
        || validDirectorActivityUpdate()
        || validTableClaim()
      );
      allow delete: if false;

      match /results/{resultId} {
        function live() {
          return get(/databases/$(database)/documents/games/$(gameId)).data;
        }
        function myTable() {
          return !signedIn() ? 0
            : (('1' in live().tables.keys()) && live().tables['1'] == request.auth.uid) ? 1
            : (('2' in live().tables.keys()) && live().tables['2'] == request.auth.uid) ? 2
            : (('3' in live().tables.keys()) && live().tables['3'] == request.auth.uid) ? 3
            : 0;
        }
        function isHowell() {
          return 'movement' in live().keys() && live().movement == 'howell';
        }
        function readsOwnResult() {
          return !isHowell()
            ? myTable() == resource.data.nsPairIndex + 1
            : myTable() == resource.data.table;
        }
        function writesOwnResult() {
          return myTable() > 0
            && live().status == 'playing'
            && request.resource.data.kind != 'manual'
            && validResult()
            && request.resource.data.table == myTable()
            && request.resource.data.updatedBy == request.auth.uid
            && resultId == 'board-' + string(request.resource.data.boardNumber) + '-ns-'
                + string(request.resource.data.nsPairIndex);
        }
        function correctMovement() {
          return isHowell() ? correctHowellFormula() && correctHowellBoards() : correctMitchellMovement();
        }
        function correctHowellFormula() {
          return (live().tableCount == 2 && ((request.resource.data.table == 1 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 3 - request.resource.data.round) || (request.resource.data.table == 2 && request.resource.data.nsPairIndex == ((3 - request.resource.data.round) % 3) + 1 && request.resource.data.ewPairIndex == ((4 - request.resource.data.round) % 3) + 1)))
            || (live().tableCount == 3 && ((request.resource.data.table == 1 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 5 - request.resource.data.round) || (request.resource.data.table == 2 && request.resource.data.nsPairIndex == ((5 - request.resource.data.round) % 5) + 1 && request.resource.data.ewPairIndex == ((8 - request.resource.data.round) % 5) + 1) || (request.resource.data.table == 3 && request.resource.data.nsPairIndex == ((6 - request.resource.data.round) % 5) + 1 && request.resource.data.ewPairIndex == ((7 - request.resource.data.round) % 5) + 1)));
        }
        function correctHowellBoards() {
          return (live().tableCount == 2 && ((request.resource.data.round == 0 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.round == 1 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.round == 2 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6)))
            || (live().tableCount == 3 && ((request.resource.data.round == 0 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.round == 1 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.round == 2 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6) || (request.resource.data.round == 3 && request.resource.data.boardNumber >= 7 && request.resource.data.boardNumber <= 8) || (request.resource.data.round == 4 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 10)));
        }
        function correctHowellPairs() {
          return (live().tableCount == 2 && ((request.resource.data.table == 1 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 3) || (request.resource.data.table == 2 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 1 && request.resource.data.ewPairIndex == 2) || (request.resource.data.table == 1 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 2) || (request.resource.data.table == 2 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 3 && request.resource.data.ewPairIndex == 1) || (request.resource.data.table == 1 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 1) || (request.resource.data.table == 2 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 2 && request.resource.data.ewPairIndex == 3)))
            || (live().tableCount == 3 && ((request.resource.data.table == 1 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 5) || (request.resource.data.table == 2 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 1 && request.resource.data.ewPairIndex == 4) || (request.resource.data.table == 3 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 2 && request.resource.data.ewPairIndex == 3) || (request.resource.data.table == 1 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 4) || (request.resource.data.table == 2 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 5 && request.resource.data.ewPairIndex == 3) || (request.resource.data.table == 3 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 1 && request.resource.data.ewPairIndex == 2) || (request.resource.data.table == 1 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 3) || (request.resource.data.table == 2 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 4 && request.resource.data.ewPairIndex == 2) || (request.resource.data.table == 3 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 5 && request.resource.data.ewPairIndex == 1) || (request.resource.data.table == 1 && request.resource.data.round == 3 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 2) || (request.resource.data.table == 2 && request.resource.data.round == 3 && request.resource.data.nsPairIndex == 3 && request.resource.data.ewPairIndex == 1) || (request.resource.data.table == 3 && request.resource.data.round == 3 && request.resource.data.nsPairIndex == 4 && request.resource.data.ewPairIndex == 5) || (request.resource.data.table == 1 && request.resource.data.round == 4 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 1) || (request.resource.data.table == 2 && request.resource.data.round == 4 && request.resource.data.nsPairIndex == 2 && request.resource.data.ewPairIndex == 5) || (request.resource.data.table == 3 && request.resource.data.round == 4 && request.resource.data.nsPairIndex == 3 && request.resource.data.ewPairIndex == 4)));
        }
        function correctMitchellMovement() {
          return request.resource.data.nsPairIndex == request.resource.data.table - 1
            && ((request.resource.data.table == 1 && request.resource.data.round == 0 && request.resource.data.ewPairIndex == 0 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 4)
              || (request.resource.data.table == 1 && request.resource.data.round == 1 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 8)
              || (request.resource.data.table == 1 && request.resource.data.round == 2 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 12)
              || (request.resource.data.table == 2 && request.resource.data.round == 0 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 8)
              || (request.resource.data.table == 2 && request.resource.data.round == 1 && request.resource.data.ewPairIndex == 0 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 12)
              || (request.resource.data.table == 2 && request.resource.data.round == 2 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 4)
              || (request.resource.data.table == 3 && request.resource.data.round == 0 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 12)
              || (request.resource.data.table == 3 && request.resource.data.round == 1 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 4)
              || (request.resource.data.table == 3 && request.resource.data.round == 2 && request.resource.data.ewPairIndex == 0 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 8));
        }
        function correctHowellMovement() {
          return (live().tableCount == 2 && ((request.resource.data.table == 1 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 3 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.table == 2 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 1 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.table == 1 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6) || (request.resource.data.table == 2 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 3 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.table == 1 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.table == 2 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 2 && request.resource.data.ewPairIndex == 3 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6)))
            || (live().tableCount == 3 && ((request.resource.data.table == 1 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 5 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.table == 2 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 1 && request.resource.data.ewPairIndex == 4 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.table == 3 && request.resource.data.round == 0 && request.resource.data.nsPairIndex == 2 && request.resource.data.ewPairIndex == 3 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6) || (request.resource.data.table == 1 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 4 && request.resource.data.boardNumber >= 7 && request.resource.data.boardNumber <= 8) || (request.resource.data.table == 2 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 5 && request.resource.data.ewPairIndex == 3 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 10) || (request.resource.data.table == 3 && request.resource.data.round == 1 && request.resource.data.nsPairIndex == 1 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.table == 1 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 3 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.table == 2 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 4 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6) || (request.resource.data.table == 3 && request.resource.data.round == 2 && request.resource.data.nsPairIndex == 5 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 7 && request.resource.data.boardNumber <= 8) || (request.resource.data.table == 1 && request.resource.data.round == 3 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 2 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 10) || (request.resource.data.table == 2 && request.resource.data.round == 3 && request.resource.data.nsPairIndex == 3 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= 2) || (request.resource.data.table == 3 && request.resource.data.round == 3 && request.resource.data.nsPairIndex == 4 && request.resource.data.ewPairIndex == 5 && request.resource.data.boardNumber >= 3 && request.resource.data.boardNumber <= 4) || (request.resource.data.table == 1 && request.resource.data.round == 4 && request.resource.data.nsPairIndex == 0 && request.resource.data.ewPairIndex == 1 && request.resource.data.boardNumber >= 5 && request.resource.data.boardNumber <= 6) || (request.resource.data.table == 2 && request.resource.data.round == 4 && request.resource.data.nsPairIndex == 2 && request.resource.data.ewPairIndex == 5 && request.resource.data.boardNumber >= 7 && request.resource.data.boardNumber <= 8) || (request.resource.data.table == 3 && request.resource.data.round == 4 && request.resource.data.nsPairIndex == 3 && request.resource.data.ewPairIndex == 4 && request.resource.data.boardNumber >= 9 && request.resource.data.boardNumber <= 10)));
        }
        function validResult() {
          return request.resource.data.keys().hasAll(['boardNumber', 'round', 'table', 'nsPairIndex', 'ewPairIndex', 'kind', 'updatedBy', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['boardNumber', 'round', 'table', 'nsPairIndex', 'ewPairIndex', 'kind', 'level', 'strain', 'doubling', 'declarer', 'tricks', 'manualScore', 'updatedBy', 'updatedAt'])
            && request.resource.data.boardNumber is int && request.resource.data.boardNumber >= 1 && request.resource.data.boardNumber <= (!isHowell() ? 12 : live().tableCount == 2 ? 6 : 10)
            && request.resource.data.round is int && request.resource.data.round >= 0 && request.resource.data.round <= (!isHowell() ? 2 : live().tableCount == 2 ? 2 : 4)
            && request.resource.data.table is int && request.resource.data.table >= 1 && request.resource.data.table <= (!isHowell() ? 3 : live().tableCount)
            && request.resource.data.nsPairIndex is int && request.resource.data.ewPairIndex is int
            && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 64
            && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= 0
            && correctMovement()
            && ((request.resource.data.kind == 'passed-out' && request.resource.data.keys().hasOnly(['boardNumber', 'round', 'table', 'nsPairIndex', 'ewPairIndex', 'kind', 'updatedBy', 'updatedAt']))
              || (request.resource.data.kind == 'manual' && request.resource.data.keys().hasOnly(['boardNumber', 'round', 'table', 'nsPairIndex', 'ewPairIndex', 'kind', 'manualScore', 'updatedBy', 'updatedAt']) && request.resource.data.manualScore is int && request.resource.data.manualScore >= -9999999 && request.resource.data.manualScore <= 9999999)
              || (request.resource.data.kind == 'contract' && request.resource.data.keys().hasOnly(['boardNumber', 'round', 'table', 'nsPairIndex', 'ewPairIndex', 'kind', 'level', 'strain', 'doubling', 'declarer', 'tricks', 'updatedBy', 'updatedAt']) && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 7 && request.resource.data.tricks is int && request.resource.data.tricks >= 0 && request.resource.data.tricks <= 13 && request.resource.data.strain in ['C', 'D', 'H', 'S', 'NT'] && request.resource.data.doubling in ['none', 'doubled', 'redoubled'] && request.resource.data.declarer in ['ns', 'ew']));
        }
        function hasCanonicalResultId() {
          return resultId == 'board-' + string(request.resource.data.boardNumber) + '-ns-'
            + string(request.resource.data.nsPairIndex);
        }

        // Director: live corrections. Everyone: after reveal. Tables: their own rows until then.
        allow read: if signedIn() && (
          request.auth.uid == live().directorUid
          || live().status == 'finished'
          || readsOwnResult()
        );

        allow create: if signedIn() && live().status == 'playing' && (
          (request.auth.uid == live().directorUid && validResult() && hasCanonicalResultId())
          || writesOwnResult()
        );
        allow update: if signedIn() && live().status == 'playing'
          && request.auth.uid == live().directorUid
          && validResult() && hasCanonicalResultId();
        allow delete: if false;
      }
    }
  }
}
